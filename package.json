{
  "name": "ciudad-escucha",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build --configLoader native",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "leaflet.markercluster": "1.5.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.10",
    "vite": "6.4.1",
    "vite-plugin-pwa": "1.0.3"
  }
}
