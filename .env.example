# En producción: NODE_ENV=production, HTTPS y DEMO_MODE=false.
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=CiudadEscucha/1.0 (interactive map lookup)
