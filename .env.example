PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
DEMO_MODE=true
# Rescue Rabbit 1: completa solamente la clave de OpenAI
OPENAI_API_KEY=
